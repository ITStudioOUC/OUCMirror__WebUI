[Unit]
Description=MirrorOUC read-only host metrics collection
[Service]
Type=oneshot
User=root
Group=mirrorouc
ExecStart=/usr/bin/python3 /usr/local/lib/mirrorouc/collect_metrics.py
UMask=0027
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/mirrorouc/metrics
ProtectHome=true
PrivateTmp=true
