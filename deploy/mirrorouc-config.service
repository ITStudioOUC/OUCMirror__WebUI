[Unit]
Description=MirrorOUC restricted tunasync configuration writer
After=tunasync-manager.service

[Service]
ExecStart=/usr/bin/python3 /usr/local/lib/mirrorouc/config-helper.py
Restart=on-failure
RestartSec=5
RuntimeDirectory=mirrorouc-config
RuntimeDirectoryMode=0755
StateDirectory=mirrorouc-config
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/tunasync /var/lib/mirrorouc-config /run/mirrorouc-config
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET

[Install]
WantedBy=multi-user.target
