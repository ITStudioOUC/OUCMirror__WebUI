# Passive accounting only; no existing rules or tables are flushed.
table inet mirrorouc_monitor {
    counter https4 { }
    counter https6 { }
    counter rsync4 { }
    counter rsync6 { }
    chain account {
        meta nfproto ipv4 tcp sport 443 counter name https4
        meta nfproto ipv4 tcp dport 443 tcp sport != 443 counter name https4
        meta nfproto ipv6 tcp sport 443 counter name https6
        meta nfproto ipv6 tcp dport 443 tcp sport != 443 counter name https6
        meta nfproto ipv4 tcp sport 873 counter name rsync4
        meta nfproto ipv4 tcp dport 873 tcp sport != 873 counter name rsync4
        meta nfproto ipv6 tcp sport 873 counter name rsync6
        meta nfproto ipv6 tcp dport 873 tcp sport != 873 counter name rsync6
    }
    chain input {
        type filter hook input priority 300; policy accept;
        iifname != "lo" jump account
    }
    chain output {
        type filter hook output priority 300; policy accept;
        oifname != "lo" jump account
    }
}
