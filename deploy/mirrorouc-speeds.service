[Unit]
Description=MirrorOUC per-mirror upstream TCP receive rates
After=tunasync-worker.service

[Service]
User=root
Group=mirrorouc
ExecStart=/usr/bin/python3 /usr/local/lib/mirrorouc/collect_job_speeds.py
Restart=on-failure
RestartSec=3
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/mirrorouc/metrics
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
